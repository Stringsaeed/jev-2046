# Vercel AI Gateway key, used to reach typesafe-ai/jev.
# Create one with:
#   npx vercel@latest --scope <team-slug> ai-gateway api-keys create --name <name>
# The command prints the key to stdout; redirect it rather than pasting it.
AI_GATEWAY_API_KEY=

# Zero Data Retention on the gateway. Pro/Enterprise plans only — leaving this
# unset avoids a 403 on Hobby.
# JEV_ZERO_DATA_RETENTION=1
